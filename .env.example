# Copy this file to ".env" and fill in your own values.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=jonggies_waffle
SESSION_SECRET=type-any-long-random-text-here
# Password for the first staff account (username: admin). Only used on the very first start.
ADMIN_PASSWORD=choose-a-strong-password
# Optional: change this if port 3000 is already in use.
PORT=3000
